{
  "name": "flix-tech/avro-serde-php",
  "description": "A library to serialize and deserialize Avro records making use of the confluent schema registry",
  "keywords": [
    "confluent-platform",
    "confluent",
    "avro",
    "schema-registry",
    "schema-evolution",
    "kafka",
    "serialization",
    "serializer",
    "deserialization",
    "symfony",
    "symfony-serializer"
  ],
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "Thomas Ploch",
      "email": "thomas.ploch@flixbus.com"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/jobcloud/schema-registry-php-client-fork",
      "no-api": true
    }
  ],
  "require": {
    "php": "^8.2",
    "beberlei/assert": "^2.9.9|^3.0.0",
    "flix-tech/confluent-schema-registry-api": "^8.2.2",
    "guzzlehttp/promises": "^1.4.0|^2.0.0|^3.1.0",
    "flix-tech/avro-php": "^5.1.0",
    "widmogrod/php-functional": "^6.0.0|^7.0.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^11.5.57",
    "phpbench/phpbench": "^1.7.0",
    "vlucas/phpdotenv": "^5.8.0",
    "symfony/serializer": "^5.4.54|^6.4.47|^7.4.21",
    "doctrine/annotations": "^2.0.2",
    "phpoption/phpoption": "^1.10.0"
  },
  "autoload": {
    "psr-4": {
      "FlixTech\\AvroSerializer\\Objects\\": "src/Objects",
      "FlixTech\\AvroSerializer\\Integrations\\": "integrations/"
    },
    "files": [
      "src/Protocol.php",
      "src/Serialize.php",
      "src/Common.php"
    ]
  },
  "suggest": {
    "symfony/serializer": "To integrate avro-serde-php into symfony ecosystem",
    "doctrine/annotations": "To enable the generation of avro schemas from annotations"
  },
  "autoload-dev": {
    "psr-4": {
      "FlixTech\\AvroSerializer\\Test\\": "test/",
      "FlixTech\\AvroSerializer\\Benchmarks\\": "benchmarks/",
      "FlixTech\\AvroSerializer\\Examples\\": "examples/"
    }
  }
}
